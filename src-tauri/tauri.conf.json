{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VongQuayMayMan",
  "version": "1.0.0",
  "identifier": "com.vongquay.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Vòng Quay May Mắn - Quay Thưởng Lớp Học",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["Vietnamese", "English"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCQ0NEQUEzQzBDNjUzM0EKUldRNlU4YkFvOXJNYTJjOE5LTzFEdVJvWGJ6UXJPcFQzdzR0SlYzN3JaZmV5SWhVbmhFRlBHbXoK",
      "endpoints": [
        "https://github.com/hongducdev/vong-quay-may-man/releases/latest/download/latest.json"
      ]
    }
  }
}
